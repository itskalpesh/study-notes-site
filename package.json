{
  "name": "study-notes-site",
  "version": "2.0.0",
  "private": true,
  "description": "A Markdoc-powered documentation site generated from markdown notes with Next.js, featuring quizzes, flashcards, and AI chat.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run build:markdoc && next build",
    "build:markdoc": "node scripts/build-markdoc.js",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@markdoc/markdoc": "^0.4.0",
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "marked": "^12.0.0",
    "dompurify": "^3.0.0",
    "highlight.js": "^11.11.0",
    "katex": "^0.16.9",
    "mermaid": "^10.9.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/react": "^18.2.0",
    "@types/node": "^20.0.0",
    "@types/dompurify": "^3.0.0",
    "eslint": "^8.50.0",
    "eslint-config-next": "^14.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
